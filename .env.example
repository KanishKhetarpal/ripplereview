# Which LLM the reviewer talks to. `echo` is the deterministic offline stub used by
# tests and `ripplereview demo`; it never makes a network call.
LLM_PROVIDER=echo
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0

# Only read when LLM_PROVIDER selects the matching vendor (Phase 2).
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Context assembler budget, in tokens, for everything handed to the model (Phase 2).
CONTEXT_TOKEN_BUDGET=60000

# How many hops out from a changed symbol the blast radius is walked (Phase 1).
BLAST_RADIUS_MAX_HOPS=3

# REST API
PORT=3000
