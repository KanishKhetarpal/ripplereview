{
  "name": "ripplereview",
  "version": "0.1.0",
  "description": "Graph-grounded AI code review. Computes the real blast radius of a change across the repository and feeds the LLM cited structural evidence instead of a bare diff.",
  "author": "Kanish Khetarpal",
  "license": "MIT",
  "private": true,
  "bin": {
    "ripplereview": "dist/cli/main-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "cli": "node --max-old-space-size=8192 -r ts-node/register/transpile-only src/cli/main-cli.ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.mjs\" \"*.mts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.mjs\" \"*.mts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "js-tiktoken": "^1.0.21",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "simple-git": "^3.36.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@swc/core": "^1.16.1",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@nestjs/core"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
